# Database Connection (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/dropshipping_db?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shopify Storefront API Credentials (Optional - Graceful mock fallback if omitted)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="apex-gear.myshopify.com"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN="shpat_xxxx_storefront_access_token"

# Shopify Admin OAuth & Webhook Credentials
SHOPIFY_CLIENT_ID="your_shopify_partner_app_api_key"
SHOPIFY_CLIENT_SECRET="your_shopify_partner_app_api_secret"
SHOPIFY_WEBHOOK_SECRET="your_shopify_webhook_hmac_secret"
